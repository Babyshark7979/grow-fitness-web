---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import BeDuaGuide from '~/components/widgets/BeDuaGuide.astro';
import EcosystemVisual from '~/components/widgets/EcosystemVisual.astro';

const metadata = {
  title: 'Grow Fitness — Tập Đúng, Ăn Đúng, Có Người Đồng Hành',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero ************************** -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Khám Phá Gói 99K',
        href: '/join',
        icon: 'tabler:flame',
      },
      { text: 'Xem Grow Chăm Bạn Thế Nào', href: '#architecture' },
    ]}
  >
    <Fragment slot="title">
      Grow Fitness — <span class="text-accent">Tập đúng, ăn đúng</span> và luôn có người đồng hành
    </Fragment>

    <Fragment slot="subtitle">
      Từ buổi tập, bữa ăn đến lời nhắc mỗi ngày —
      <span class="font-semibold text-white">bạn không còn phải tự xoay xở.</span>
    </Fragment>
  </Hero>

  <!-- Hệ sinh thái Grow Fitness ********** -->

  <EcosystemVisual
    image="/images/grow-fitness-ecosystem.webp"
    tagline="Một hệ sinh thái — chăm bạn mỗi ngày"
    title="Tập đúng. Ăn đúng. Tự chủ hơn."
    subtitle="Phòng tập nữ, Bé Dứa nhắc lịch mỗi ngày, Bếp Healthy và cộng đồng cùng giúp bạn tiến bộ thật."
  />

  <!-- AI Simulation — khung chat Bé Dứa ********* -->

  <section class="px-4 py-16 sm:px-6 mx-auto max-w-6xl">
    <div class="mb-10 text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary mb-2">Nhắc đúng lúc, chăm mỗi ngày</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-tight text-white">
        Bé Dứa — trợ lý nhắc bạn tập và ăn đúng mỗi ngày
      </h2>
    </div>

    <div class="mx-auto max-w-sm">
      <div class="rounded-[2.5rem] border border-line bg-card p-3 shadow-2xl">
        <div class="rounded-[2rem] bg-page overflow-hidden">
          <!-- header giả lập app chat -->
          <div class="flex items-center gap-3 border-b border-line px-4 py-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-lg">🍍</div>
            <div>
              <p class="font-semibold text-white leading-tight">Bé Dứa</p>
              <p class="text-xs text-primary">Trợ lý tập luyện · đang sẵn sàng</p>
            </div>
          </div>
          <!-- hội thoại -->
          <div class="space-y-3 px-4 py-5 text-sm">
            <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-card border border-line px-4 py-3 text-white">
              Hôm nay 18:30 có lịch tập Mông–Đùi tại S109 Ocean Park 1. Bạn có tham gia được không?
            </div>
            <div class="ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-primary px-4 py-3 text-white">
              Hôm nay họp liên tục mệt quá, cổ vai gáy nhức mỏi không nhúc nhích nổi Bé Dứa ơi...
            </div>
            <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-card border border-line px-4 py-3 text-white">
              Mình gợi ý đổi sang bài giãn cơ nhẹ và dời buổi Mông–Đùi sang sáng mai. Bạn thấy lịch này ổn không?
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bốn trụ cột giải pháp ********** -->

  <Features2
    tagline="Giải pháp 4 trong 1"
    title="Hệ Sinh Thái Chăm Sóc Vóc Dáng Toàn Diện"
    subtitle="Từ nơi tập, bữa ăn đến lời nhắc — mọi thứ cùng hướng về một mục tiêu của bạn."
    items={[
      {
        title: '🧘 Phòng tập dành riêng cho nữ',
        description: 'Không gian tập riêng tư 100%, không lo bị soi xét hay chèo kéo mua thẻ. HLV sửa từng động tác.',
        icon: 'tabler:woman',
      },
      {
        title: '🍍 Bé Dứa nhắc lịch mỗi ngày',
        description: 'Nhắc buổi tập, theo dõi tiến bộ và gợi ý điều chỉnh theo mức năng lượng trong ngày.',
        icon: 'tabler:device-watch-stats',
      },
      {
        title: '🥗 Bếp Grow chuẩn bị bữa ăn',
        description: 'Bữa ăn đủ chất, dễ ăn và phù hợp mục tiêu để bạn không phải tự tính toán.',
        icon: 'tabler:salad',
      },
      {
        title: '💎 Cộng đồng phụ nữ cùng tiến bộ',
        description: 'Tập cùng những người có mục tiêu giống bạn để vui hơn và dễ duy trì hơn.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- Kiến trúc Flywheel ********** -->

  <section id="architecture" class="px-4 py-16 sm:px-6 mx-auto max-w-6xl border-t border-line">
    <div class="mb-12 text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary mb-2">Grow dành cho ai?</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-tight text-white mb-4">
        Ba Cách Đồng Hành Cùng Grow Fitness
      </h2>
      <p class="text-gray-400 max-w-3xl mx-auto">
        Bạn có thể bắt đầu tập luyện, phát triển nghề nghiệp hoặc góp vốn mở một cơ sở mới.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-card border border-line p-8 rounded-2xl flex flex-col justify-between">
        <div>
          <div class="text-3xl mb-4">👑</div>
          <h3 class="text-xl font-bold text-white mb-3">Trải Nghiệm 3 Buổi 99K</h3>
          <p class="text-gray-400 text-sm mb-6">
            Dành cho phụ nữ muốn thử 3 buổi tập riêng tư, đo chỉ số cơ thể và được sửa động tác.
          </p>
        </div>
        <a href="/join" class="inline-flex items-center text-primary font-semibold hover:underline">
          Khám phá gói 99K &rarr;
        </a>
      </div>

      <div class="bg-card border border-line p-8 rounded-2xl flex flex-col justify-between">
        <div>
          <div class="text-3xl mb-4">🔑</div>
          <h3 class="text-xl font-bold text-white mb-3">Trở Thành Quản Lý Phòng Tập</h3>
          <p class="text-gray-400 text-sm mb-6">
            Dành cho người muốn được đào tạo để xây đội ngũ, chăm khách và quản lý một cơ sở.
          </p>
        </div>
        <a href="/careers" class="inline-flex items-center text-primary font-semibold hover:underline">
          Xem Cơ Hội Nghề Nghiệp &rarr;
        </a>
      </div>

      <div class="bg-card border border-line p-8 rounded-2xl flex flex-col justify-between">
        <div>
          <div class="text-3xl mb-4">💼</div>
          <h3 class="text-xl font-bold text-white mb-3">Góp Vốn Mở Cơ Sở</h3>
          <p class="text-gray-400 text-sm mb-6">
            Dành cho nhà đầu tư muốn góp vốn vào một cơ sở cụ thể và nhận phần chia doanh thu rõ ràng.
          </p>
        </div>
        <a href="/invest" class="inline-flex items-center text-primary font-semibold hover:underline">
          Xem Cơ Hội Đầu Tư &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Hướng dẫn Bé Dứa ********** -->

  <BeDuaGuide />

  <!-- CTA ******************* -->

  <Steps
    title="Bắt đầu hành trình lột xác vóc dáng ngay hôm nay"
    tagline="Chỉ 3 bước đơn giản"
    items={[
      {
        title: 'Bước 1: Đăng ký gói 99K',
        description: 'Điền thông tin để giữ chỗ 3 buổi tập dành riêng cho nữ và đo chỉ số cơ thể.',
        icon: 'tabler:number-1',
      },
      {
        title: 'Bước 2: Kết nối Bé Dứa',
        description: 'Bé Dứa nhắc lịch tập, theo dõi bữa ăn và giúp bạn duy trì thói quen.',
        icon: 'tabler:number-2',
      },
      {
        title: 'Bước 3: Tận hưởng vóc dáng rạng rỡ',
        description: 'Cảm nhận cơ thể khỏe hơn, vóc dáng gọn hơn và tự tin hơn mỗi ngày.',
        icon: 'tabler:number-3',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=2070&q=80',
      alt: 'Tập luyện rạng rỡ tại Grow Fitness',
    }}
  />
</Layout>
