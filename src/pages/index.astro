---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import BeDuaGuide from '~/components/widgets/BeDuaGuide.astro';
import VideoPlayer from '~/components/widgets/VideoPlayer.astro';

const metadata = {
  title: 'Grow Fitness — Hệ Điều Hành Fitness Cá Nhân Đầu Tiên Tại Việt Nam',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero ************************** -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Khám Phá Gói 99K',
        href: '/join',
        icon: 'tabler:flame',
      },
      { text: 'Tìm Hiểu Mô Hình', href: '#architecture' },
    ]}
    image={{
      src: '/images/hero-lienn.png',
      alt: 'Chị Liên — Founder Grow Fitness tại phòng tập S109 Ocean Park',
    }}
  >
    <Fragment slot="title">
      Grow Fitness — <span class="text-accent">Hệ Điều Hành Fitness</span> Cá Nhân Đầu Tiên Tại Việt Nam
    </Fragment>

    <Fragment slot="subtitle">
      Private Gym Nữ + AI Huấn Luyện Viên 24/7. <span class="font-semibold text-white"
        >Không bỏ lỡ một ngày tập nào.</span
      >
    </Fragment>
  </Hero>

  <!-- Video Motion Graphic ********** -->

  <VideoPlayer
    src="/images/video_motion_graphic.mp4"
    poster="/images/Lienhero.png"
    tagline="Xem 60 giây hiểu ngay"
    title="Grow Fitness vận hành như thế nào?"
    subtitle="Motion graphic mô hình Hệ Điều Hành Fitness — Private Gym Nữ + AI HLV 24/7."
  />

  <!-- AI Simulation — khung chat Bé Dứa ********* -->

  <section class="px-4 py-16 sm:px-6 mx-auto max-w-6xl">
    <div class="mb-10 text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary mb-2">AI đồng hành thật</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-tight text-white">
        Bé Dứa — AI HLV không cho bạn bỏ cuộc
      </h2>
    </div>

    <div class="mx-auto max-w-sm">
      <div class="rounded-[2.5rem] border border-line bg-card p-3 shadow-2xl">
        <div class="rounded-[2rem] bg-page overflow-hidden">
          <!-- header giả lập app chat -->
          <div class="flex items-center gap-3 border-b border-line px-4 py-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-lg">🍍</div>
            <div>
              <p class="font-semibold text-white leading-tight">Bé Dứa</p>
              <p class="text-xs text-primary">AI Huấn Luyện Viên · online</p>
            </div>
          </div>
          <!-- hội thoại -->
          <div class="space-y-3 px-4 py-5 text-sm">
            <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-card border border-line px-4 py-3 text-white">
              Hôm nay 18:30 lịch tập Mông-Đùi tại S109 Ocean Park. Bạn chưa check-in?
            </div>
            <div class="ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-primary px-4 py-3 text-white">
              Hôm nay công ty nhiều việc quá Bé Dứa ơi...
            </div>
            <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-card border border-line px-4 py-3 text-white">
              Hệ thống đã tự dời lịch sang ca 6h sáng mai và điều chỉnh giảm 15% tạ để bạn không bị rách cơ. Đừng để lỡ
              2 ngày liên tiếp nhé!
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Hướng dẫn dùng Trợ lý AI Bé Dứa & QR Code -->
  <BeDuaGuide />

  <!-- Bộ môn tập luyện ************** -->

  <Features2
    title="Các Bộ Môn Tập Luyện"
    subtitle="Đa dạng lớp cho mọi mục tiêu — từ đốt mỡ tới phục hồi."
    tagline="Showcase"
    columns={3}
    items={[
      {
        title: 'Step cơ bản & nâng cao',
        description: 'Đốt calo nhịp điệu trên bục step — vui, dễ vào, hiệu quả cao.',
        icon: 'tabler:stairs',
      },
      {
        title: 'Dance Fitness & Aerobic',
        description: 'Vừa nhảy vừa siết dáng theo nhạc — quên luôn là đang tập.',
        icon: 'tabler:music',
      },
      {
        title: 'HIIT / Tabata / Cardio',
        description: 'Đốt mỡ cường độ cao ngắt quãng — tối đa hiệu quả trong 45 phút.',
        icon: 'tabler:flame',
      },
      {
        title: 'Bodyweight & Kháng lực tạ nhẹ',
        description: 'Săn chắc toàn thân với chính trọng lượng cơ thể và tạ nhẹ an toàn.',
        icon: 'tabler:barbell',
      },
      {
        title: 'Core - Bụng - Eo',
        description: 'Chuyên sâu vùng trung tâm — eo thon, bụng phẳng, lưng khoẻ.',
        icon: 'tabler:target',
      },
      {
        title: 'Giãn cơ phục hồi (Yoga, Pilates)',
        description: 'Thả lỏng, kéo giãn, phục hồi — để cơ thể sẵn sàng cho buổi sau.',
        icon: 'tabler:yoga',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Timeline ********************** -->

  <div id="architecture">
    <Steps
      title="Hành trình 3 mốc của Grow Fitness"
      tagline="Timeline"
      items={[
        {
          title: '2022 — <span class="font-medium">Phòng nhỏ chung cư</span>',
          description: 'Mô hình tập luyện 1:1 cá nhân hóa sơ khai.',
          icon: 'tabler:home',
        },
        {
          title: '2024 — <span class="font-medium">Xuống mặt bằng riêng (Ocean Park 1)</span>',
          description: 'Mở rộng không gian chuyên nghiệp dành riêng cho nữ.',
          icon: 'tabler:building',
        },
        {
          title: '2026 — <span class="font-medium">AI Private Gym</span>',
          description: 'Tích hợp Hệ điều hành AI HLV 24/7 & Quản trị tự động.',
          icon: 'tabler:robot',
        },
      ]}
      image={{
        src: 'https://images.unsplash.com/photo-1571902943202-507ec2618e8f?auto=format&fit=crop&w=2075&q=80',
        alt: 'Không gian Grow Fitness Ocean Park',
      }}
    />
  </div>

  <!-- Split CTA — 3 phễu ************ -->

  <section class="px-4 py-16 sm:px-6 mx-auto max-w-6xl">
    <div class="mb-10 text-center">
      <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-tight text-white">Bạn thuộc về đâu?</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      <a
        href="/join"
        class="group rounded-2xl bg-card border border-line p-8 text-center transition hover:border-primary hover:-translate-y-1"
      >
        <div class="text-4xl mb-4">🏋️</div>
        <h3 class="font-heading text-xl text-white mb-2">Tôi Muốn Tập</h3>
        <p class="text-muted mb-4">Trải nghiệm Khám Phá 3 buổi chỉ 99K.</p>
        <span class="font-semibold text-primary group-hover:text-secondary">Đặt Chỗ 99K →</span>
      </a>
      <a
        href="/careers"
        class="group rounded-2xl bg-card border border-line p-8 text-center transition hover:border-primary hover:-translate-y-1"
      >
        <div class="text-4xl mb-4">💼</div>
        <h3 class="font-heading text-xl text-white mb-2">Tôi Muốn Làm Việc</h3>
        <p class="text-muted mb-4">Trở thành Head PT làm chủ cơ sở, hưởng 90% lợi nhuận vượt khoán.</p>
        <span class="font-semibold text-primary group-hover:text-secondary">Xem Cơ Chế →</span>
      </a>
      <a
        href="/invest"
        class="group rounded-2xl bg-card border border-line p-8 text-center transition hover:border-primary hover:-translate-y-1"
      >
        <div class="text-4xl mb-4">📈</div>
        <h3 class="font-heading text-xl text-white mb-2">Tôi Muốn Đầu Tư</h3>
        <p class="text-muted mb-4">Đồng hành cùng mô hình SPV 200M & Cỗ máy Flywheel.</p>
        <span class="font-semibold text-primary group-hover:text-secondary">Tìm Hiểu SPV →</span>
      </a>
    </div>
  </section>
</Layout>
