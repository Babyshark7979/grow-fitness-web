---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import LeadForm from '~/components/LeadForm.astro';

const metadata = {
  title: 'Tuyển Quản Lý Phòng Tập — Cùng Grow Xây Cơ Sở',
  description:
    'Không cần kinh nghiệm quản lý. Grow đào tạo từ đầu để bạn có cơ hội đạt thu nhập 15–30 triệu mỗi tháng.',
};
---

<Layout metadata={metadata}>
  <!-- Hero ************************** -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Tôi Muốn Thử',
        href: '#form-headpt',
        icon: 'tabler:send',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?auto=format&fit=crop&w=2070&q=80',
      alt: 'Quản lý phòng tập tại Grow Fitness',
    }}
  >
    <Fragment slot="title">
      Không cần kinh nghiệm. <span class="text-accent">Chỉ cần bạn thích kiếm tiền và dám học.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Grow đào tạo từ đầu để bạn biết chăm khách, xây đội ngũ và quản lý một phòng tập dành riêng cho nữ.
    </Fragment>
  </Hero>

  <!-- 4 trụ cột ********************* -->

  <Features
    tagline="Quyền lợi rõ ràng"
    title="4 Lý Do Gia Nhập Grow"
    subtitle="Biết rõ mình được gì, học gì và có thể tiến xa đến đâu."
    columns={2}
    items={[
      {
        title: '💰 Thu nhập tăng theo năng lực',
        description: 'Mục tiêu 15–30 triệu mỗi tháng sau 3 tháng đào tạo, tùy kết quả thực tế.',
        icon: 'tabler:cash',
      },
      {
        title: '🚀 Có đường lên quản lý',
        description: 'Không chỉ đứng lớp. Bạn được học cách chăm khách, xây đội ngũ và vận hành một cơ sở.',
        icon: 'tabler:trending-up',
      },
      {
        title: '✨ Trở thành phiên bản tốt hơn',
        description: 'Rèn sự tự tin, kỷ luật, cách giao tiếp và hình ảnh của một người dẫn dắt.',
        icon: 'tabler:robot',
      },
      {
        title: '🎓 Có người đào tạo từ đầu',
        description: 'Được cầm tay chỉ việc theo từng bước; chưa biết quản lý vẫn có thể bắt đầu.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- Thu nhập ********************** -->

  <section class="px-4 py-16 sm:px-6 mx-auto max-w-4xl">
    <div
      class="rounded-3xl border border-primary/40 bg-card p-8 text-center shadow-[0_0_35px_rgba(255,46,136,0.12)] md:p-12"
    >
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">Thu nhập rõ ràng</p>
      <h2 class="font-heading text-3xl font-bold text-white md:text-5xl">15–30 triệu/tháng</h2>
      <p class="mt-4 text-muted">Mục tiêu sau 3 tháng đào tạo, phụ thuộc vào năng lực và kết quả làm việc thực tế.</p>
    </div>
  </section>

  <!-- Quy trình ********************* -->

  <section class="px-4 py-16 sm:px-6 mx-auto max-w-5xl">
    <div class="mb-10 text-center">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-primary">3 bước bắt đầu</p>
      <h2 class="font-heading text-3xl font-bold text-white md:text-4xl">Đơn Giản, Không Vòng Vo</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {
        ['1. Nhắn Tin', '2. Phỏng Vấn', '3. Bắt Đầu'].map((step) => (
          <div class="rounded-2xl border border-line bg-card p-7 text-center font-heading text-xl font-bold text-white">
            {step}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Form Ứng tuyển ******************* -->

  <section id="form-headpt" class="px-4 py-16 sm:px-6 mx-auto max-w-3xl border-t border-line">
    <div class="mb-10 text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary mb-2">Cho mình một cơ hội</p>
      <h2 class="font-heading text-3xl font-bold tracking-tight text-white mb-2">Đăng Ký Thử Sức</h2>
      <p class="text-gray-400 text-sm">Để lại tên và số điện thoại, Grow sẽ gọi trao đổi rõ công việc.</p>
    </div>

    <LeadForm
      id="form-headpt"
      formType="careers-headpt"
      button="Tôi Muốn Thử"
      fields={[
        { name: 'ho_ten', label: 'Họ và tên', placeholder: 'VD: Nguyễn Thu Hà' },
        { name: 'so_dien_thoai', label: 'Số điện thoại (Zalo)', type: 'tel', placeholder: 'VD: 0912 345 678' },
      ]}
      disclaimer="Bằng việc gửi thông tin này, bạn đồng ý để Grow Fitness liên hệ trực tiếp qua Zalo hoặc điện thoại."
    />
  </section>
</Layout>
