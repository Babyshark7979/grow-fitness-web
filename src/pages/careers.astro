---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import LeadForm from '~/components/LeadForm.astro';

const metadata = {
  title: 'Thoát Kiếp Bác Xe Ôm Công Nghệ — Làm Chủ Mảnh Đất Tự Quản 30M',
  description:
    'Cơ hội dành cho Head PT làm chủ mảnh đất tự quản 30M, giữ 90% lợi nhuận thặng dư và sở hữu cổ phần ảo Phantom Stock 12T.',
};
---

<Layout metadata={metadata}>
  <!-- Hero ************************** -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Nộp Hồ Sơ Head PT',
        href: '#form-headpt',
        icon: 'tabler:send',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?auto=format&fit=crop&w=2070&q=80',
      alt: 'Làm chủ cơ sở Private Gym tại Grow Fitness',
    }}
  >
    <Fragment slot="title">
      Thoát Kiếp <span class="text-accent">"Bác Xe Ôm Công Nghệ"</span> — Làm Chủ Mảnh Đất Tự Quản 30M
    </Fragment>

    <Fragment slot="subtitle">
      Cầm chìa khóa vận hành cơ sở Private Gym Nữ 5 sao. Giữ 90% lợi nhuận vượt khoán 30M và
      <span class="font-semibold text-white">sở hữu Cổ phần ảo Phantom Stock 12 tháng.</span>
    </Fragment>
  </Hero>

  <!-- 4 trụ cột ********************* -->

  <Features
    tagline="Quyền lợi rõ ràng"
    title="4 Lý Do Head PT Nên Chọn Grow Fitness"
    subtitle="Không còn bị cai thầu chăn bò vắt chanh bỏ vỏ hay lo cướp khách cày số."
    columns={2}
    items={[
      {
        title: '💰 Giữ 90% lợi nhuận vượt khoán',
        description: 'Sau mức chi phí vận hành 30 triệu/tháng, bạn và đội ngũ giữ 90% phần thặng dư. Làm nhiều hưởng nhiều.',
        icon: 'tabler:cash',
      },
      {
        title: '📈 Cổ phần ảo Phantom Stock 12T',
        description: 'Đồng hành đủ 12 tháng và vận hành cơ sở tốt, bạn được trao cổ phần gắn chặt với dòng tiền cơ sở trọn đời.',
        icon: 'tabler:trending-up',
      },
      {
        title: '🤖 AI Bé Dứa gánh 80% vận hành',
        description: 'AI tự động nhắc lịch, chăm sóc khách, bán gia hạn. Bạn chỉ tập trung nâng tầm nghề nghiệp.',
        icon: 'tabler:robot',
      },
      {
        title: '🛡️ Văn hóa văn minh — Không cướp khách',
        description: 'Môi trường làm việc nhân văn, quy trình hệ thống hóa 100%, bảo vệ thu nhập và danh dự người làm nghề.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- Form Ứng tuyển ******************* -->

  <section id="form-headpt" class="px-4 py-16 sm:px-6 mx-auto max-w-3xl border-t border-line">
    <div class="mb-10 text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary mb-2">Gia nhập đội ngũ làm chủ</p>
      <h2 class="font-heading text-3xl font-bold tracking-tight text-white mb-2">Đăng Ký Phỏng Vấn Head PT Cơ Sở</h2>
      <p class="text-gray-400 text-sm">Điền thông tin bên dưới để Ban điều hành xếp lịch trao đổi mô hình tự quản 30M.</p>
    </div>

    <LeadForm
      id="form-careers-headpt"
      formType="careers-headpt"
      button="Nộp Hồ Sơ Head PT Ngay"
      fields={[
        { name: 'ho_ten', label: 'Họ và Tên', placeholder: 'VD: Trần Văn Nam' },
        { name: 'so_dien_thoai', label: 'Số Điện Thoại (Zalo)', type: 'tel', placeholder: 'VD: 0988 777 666' },
        {
          name: 'kinh_nghiem',
          label: 'Kinh nghiệm huấn luyện',
          type: 'select',
          options: ['Dưới 1 năm', '1 - 3 năm', 'Trên 3 năm (Head PT / Manager)'],
        },
      ]}
      disclaimer="Bằng việc nộp hồ sơ, bạn đồng ý trao đổi bảo mật mô hình khoán tự quản 30M cùng Grow."
    />
  </section>
</Layout>
