---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import LeadForm from '~/components/LeadForm.astro';

const metadata = {
  title: 'Khám Phá Grow Fitness 3 Buổi Chỉ 99K — Ocean Park 1',
  description:
    'Gói Khám Phá 99K tại Ocean Park 1: đo chỉ số cơ thể, tập nhóm nữ và được huấn luyện viên sửa động tác, cam kết không chèo kéo mua thẻ.',
};

const priceList = [
  {
    emoji: '🎁',
    name: 'Gói Khám Phá Grow 99K',
    price: '99.000đ',
    unit: '/ 3 ngày',
    detail: 'Đo chỉ số cơ thể + tập nhóm nữ + huấn luyện viên sửa từng động tác',
    highlight: true,
  },
  {
    emoji: '🧘',
    name: 'Lớp tập xả stress cho nữ',
    price: 'từ 599.000đ',
    unit: '/ 21 ngày',
    detail: 'Nhiều ca tập linh hoạt, không gian 5 sao không bị soi xét',
  },
  {
    emoji: '🥗',
    name: 'Đồng hành dinh dưỡng Bếp Grow',
    price: 'từ 1.999.000đ',
    unit: '/ tháng',
    detail: 'Bé Dứa + chuyên gia theo sát bữa ăn',
  },
  {
    emoji: '🔥',
    name: 'Tập nhóm + Dinh dưỡng trọn gói',
    price: 'từ 2.999.000đ',
    unit: '/ tháng',
    detail: 'Tập nhóm + dinh dưỡng trọn gói',
  },
  {
    emoji: '🏋️',
    name: 'Tập riêng 1-1',
    price: 'từ 500.000đ',
    unit: '/ buổi',
    detail: 'Huấn luyện viên riêng, không gian kín đáo cho nữ doanh nhân',
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero ************************** -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Đăng Ký Khám Phá 99K',
        href: '#form-join',
        icon: 'tabler:flame',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=2070&q=80',
      alt: 'Khám phá gói 99K tại Grow Fitness Ocean Park 1',
    }}
  >
    <Fragment slot="title">
      Khám Phá Grow Fitness <span class="text-accent">3 Buổi Chỉ 99K</span>
    </Fragment>

    <Fragment slot="subtitle">
      Đo chỉ số cơ thể, thử lớp tập nhóm nữ và được huấn luyện viên sửa động tác —
      <span class="font-semibold text-white">cam kết không chèo kéo mua thẻ.</span>
    </Fragment>
  </Hero>

  <!-- Bảng dịch vụ ******************* -->

  <section class="px-4 py-16 sm:px-6 mx-auto max-w-5xl">
    <div class="mb-12 text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary mb-2">Bảng Giá Minh Bạch</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-tight text-white mb-4">
        Các Lựa Chọn Trải Nghiệm Tại Grow Fitness
      </h2>
      <p class="text-gray-400">Không có phí ẩn. Chọn gói phù hợp với lịch làm việc của bạn.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        priceList.map((item) => (
          <div
            class={`rounded-2xl border p-6 flex flex-col justify-between ${
              item.highlight
                ? 'border-primary bg-card shadow-lg shadow-primary/10 relative overflow-hidden'
                : 'border-line bg-card'
            }`}
          >
            {item.highlight && (
              <div class="absolute top-0 right-0 bg-primary text-white text-xs font-bold px-3 py-1 rounded-bl-lg uppercase tracking-wider">
                Khuyên Chọn
              </div>
            )}
            <div>
              <div class="text-3xl mb-3">{item.emoji}</div>
              <h3 class="text-lg font-bold text-white mb-2">{item.name}</h3>
              <div class="flex items-baseline gap-1 mb-4">
                <span class="text-2xl font-extrabold text-accent">{item.price}</span>
                <span class="text-xs text-gray-400">{item.unit}</span>
              </div>
              <p class="text-gray-400 text-sm mb-6">{item.detail}</p>
            </div>
            <a
              href="#form-join"
              class={`w-full py-2.5 px-4 rounded-xl font-semibold text-center text-sm transition ${
                item.highlight
                  ? 'bg-primary text-white hover:bg-primary/90'
                  : 'bg-page border border-line text-white hover:bg-card'
              }`}
            >
              Chọn Gói Này
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Lead Form Section ************** -->

  <section id="form-join" class="px-4 py-16 sm:px-6 mx-auto max-w-3xl border-t border-line">
    <div class="mb-10 text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary mb-2">Đăng ký giữ suất 99K</p>
      <h2 class="font-heading text-3xl font-bold tracking-tight text-white mb-2">
        Nhận 3 Buổi Tập Nữ + Đo Chỉ Số Cơ Thể
      </h2>
      <p class="text-gray-400 text-sm">
        Điền thông tin bên dưới để trợ lý xếp lịch tập xả stress tại S109 Ocean Park 1.
      </p>
    </div>

    <LeadForm
      id="form-join-99k"
      formType="join-99k"
      button="Đăng Ký Giữ Suất 99K Ngay"
      fields={[
        { name: 'ho_ten', label: 'Họ và Tên', placeholder: 'VD: Nguyễn Thu Hà' },
        { name: 'so_dien_thoai', label: 'Số Điện Thoại (Zalo)', type: 'tel', placeholder: 'VD: 0912 345 678' },
        {
          name: 'muc_tieu',
          label: 'Mục tiêu trải nghiệm',
          type: 'select',
          options: ['Xả stress & Vai gáy', 'Giảm mỡ bụng tự tin chốt deal', 'Tập thử 3 buổi 99K'],
        },
      ]}
      disclaimer="Bằng việc gửi thông tin này, bạn đồng ý để Grow Fitness liên hệ qua Zalo tư vấn ca tập."
    />
  </section>
</Layout>
