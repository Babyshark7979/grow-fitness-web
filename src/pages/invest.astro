---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import LeadForm from '~/components/LeadForm.astro';

const metadata = {
  title: 'Đầu Tư SPV 200M — Chuỗi Private Gym Không Pha Loãng Cổ Phần',
  description:
    'Góp vốn SPV 200 triệu theo từng cơ sở độc lập. Lợi nhuận chia trực tiếp từ doanh thu RBF và có hợp đồng mua lại Buyback rõ ràng.',
};
---

<Layout metadata={metadata}>
  <!-- Hero ************************** -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Nhận Hồ Sơ SPV 200M',
        href: '#form-spv',
        icon: 'tabler:file-analytics',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=2070&q=80',
      alt: 'Cơ hội góp vốn SPV 200M mở cơ sở Grow Fitness',
    }}
  >
    <Fragment slot="title">
      Đầu Tư SPV 200M/Suất — <span class="text-accent">Tài Trợ Doanh Thu RBF & Đòn Bẩy Buyback</span>
    </Fragment>

    <Fragment slot="subtitle">
      Góp vốn theo từng cơ sở độc lập. Nhận dòng tiền chia trực tiếp từ doanh thu,
      <span class="font-semibold text-white">không sợ mua phải cái tủ lạnh thiu và có hợp đồng mua lại 100% rõ ràng.</span>
    </Fragment>
  </Hero>

  <!-- 3 module hạ tầng ************** -->

  <Features
    tagline="Cách dòng tiền vận hành"
    title="3 Trụ Cột Cho Nhà Đầu Tư SPV"
    subtitle="Dòng tiền minh bạch, quản trị bằng CFO Dashboard Tab 5 và đòn bẩy Buyback."
    columns={3}
    items={[
      {
        title: '🏢 Góp vốn SPV 200M độc lập',
        description: 'Mỗi suất 200 triệu chỉ dùng cho 1 cơ sở cụ thể. Nhà đầu tư nhận phần chia trực tiếp từ doanh thu RBF.',
        icon: 'tabler:building-bank',
      },
      {
        title: '🔄 Hợp đồng Buyback mua lại',
        description: 'Công ty mẹ giữ 100% sở hữu lâu dài, có điều khoản mua lại suất SPV đúng hạn và rõ ràng.',
        icon: 'tabler:refresh',
      },
      {
        title: '📈 Biên lợi nhuận O2O 90%',
        description: 'Bánh răng Offline kéo khách ➔ AI Bé Dứa & Skool Online nhân bản doanh thu cao vượt trội.',
        icon: 'tabler:chart-arrows-vertical',
      },
    ]}
  />

  <!-- Form SPV ******************* -->

  <section id="form-spv" class="px-4 py-16 sm:px-6 mx-auto max-w-3xl border-t border-line">
    <div class="mb-10 text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary mb-2">Hồ sơ tài chính minh bạch</p>
      <h2 class="font-heading text-3xl font-bold tracking-tight text-white mb-2">Yêu Cầu Hồ Sơ Góp Vốn SPV 200M</h2>
      <p class="text-gray-400 text-sm">Điền thông tin bên dưới để Ban quản trị quỹ gửi bản thẩm định dòng tiền RBF cơ sở.</p>
    </div>

    <LeadForm
      id="form-invest-spv"
      formType="invest-spv"
      button="Nhận Hồ Sơ SPV 200M Ngay"
      fields={[
        { name: 'ho_ten', label: 'Họ và Tên', placeholder: 'VD: Lê Hoàng Nam' },
        { name: 'so_dien_thoai', label: 'Số Điện Thoại (Zalo)', type: 'tel', placeholder: 'VD: 0903 111 222' },
        {
          name: 'so_suat',
          label: 'Dự kiến số suất SPV quan tâm',
          type: 'select',
          options: ['1 suất (200 triệu)', '2-3 suất (400 - 600 triệu)', 'Trên 3 suất (Đầu tư cả cơ sở)'],
        },
      ]}
      disclaimer="Bằng việc gửi yêu cầu, bạn đồng ý nhận hồ sơ thẩm định tài chính bảo mật từ Grow."
    />
  </section>
</Layout>
