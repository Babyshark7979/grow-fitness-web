---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Đầu tư',
  description: 'Đồng hành đầu tư cùng Grow Fitness — mô hình AI Private Gym đầu tiên.',
};
---

<Layout metadata={metadata}>
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Liên hệ với chúng tôi',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Đầu tư vào <span class="text-accent">AI Private Gym</span>
    </Fragment>

    <Fragment slot="subtitle">
      Grow Fitness đang mở vòng đồng hành cùng nhà đầu tư tin vào mô hình private gym vận hành bởi AI. Để lại thông tin
      — chúng tôi sẽ gửi tài liệu chi tiết.
    </Fragment>
  </CallToAction>
</Layout>
