---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import LeadForm from '~/components/LeadForm.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Liên Hệ',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Liên hệ" title="Kết Nối Cùng Grow Fitness!" />

  <section class="px-4 py-8 sm:px-6 mx-auto max-w-6xl">
    <div class="mb-10 text-center">
      <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-tight text-white">Gửi tin nhắn cho chúng tôi!</h2>
      <p class="mt-3 text-muted max-w-2xl mx-auto">
        Bạn có thắc mắc về lịch tập, gói 99K hoặc cơ hội góp vốn mở cơ sở? Hãy để lại thông tin, đội ngũ Grow sẽ hỗ trợ
        bạn ngay lập tức.
      </p>
    </div>
    <LeadForm
      id="form"
      formType="join-99k"
      button="Gửi thông tin"
      fields={[
        { name: 'ho_ten', label: 'Họ và Tên', placeholder: 'VD: Nguyễn Thu Hà' },
        { name: 'so_dien_thoai', label: 'Số Điện Thoại (Zalo)', type: 'tel', placeholder: 'VD: 0912 345 678' },
        {
          name: 'quan_tam',
          label: 'Bạn quan tâm điều gì?',
          type: 'select',
          options: ['Tập luyện & Gói 99K', 'Ứng tuyển quản lý phòng tập', 'Góp vốn mở cơ sở'],
        },
      ]}
      textarea={{
        name: 'nhu_cau',
        label: 'Nhu cầu cần hỗ trợ',
        placeholder: 'VD: Em muốn giảm mỡ bụng, tập ca tối sau giờ làm...',
      }}
      disclaimer="Bằng việc gửi thông tin này, bạn đồng ý để Grow Fitness liên hệ trực tiếp qua Zalo hoặc điện thoại."
      typeSelect="quan_tam"
      typeMap={{
        'Tập luyện & Gói 99K': { form_type: 'join-99k', detail: 'muc_tieu' },
        'Ứng tuyển quản lý phòng tập': { form_type: 'careers-headpt', detail: 'kinh_nghiem' },
        'Góp vốn mở cơ sở': { form_type: 'invest-spv', detail: 'so_suat' },
      }}
    />
    <p class="mt-4 text-center text-sm text-muted">Đội ngũ Grow phản hồi trong vòng 5–15 phút.</p>
  </section>

  <!-- Features2 Widget ************** -->

  <Features2
    title="Kênh Hỗ Trợ Trực Tiếp"
    items={[
      {
        title: 'Tập luyện & Gói 99K',
        description: 'Tư vấn lớp tập nhóm cho nữ, tập riêng 1-1 và đăng ký gói Khám Phá 3 buổi 99K.',
        icon: 'tabler:flame',
      },
      {
        title: 'Tuyển quản lý phòng tập',
        description: 'Giải đáp công việc, lộ trình đào tạo, cách tính thu nhập và thưởng dài hạn.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Góp vốn mở cơ sở',
        description: 'Nhận hồ sơ góp vốn 200 triệu mỗi suất, cách chia doanh thu và điều khoản mua lại.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Zalo Hotline',
        description:
          'Chị Diệu Liên — người phụ trách vận hành — <a class="text-primary font-semibold underline" href="https://zalo.me/0962468222" target="_blank" rel="noopener">0962 468 222</a>',
        icon: 'tabler:headset',
      },
      {
        title: 'Địa Chỉ Cơ Sở 1',
        description: 'Tòa S109 - 01S10, Vinhomes Ocean Park 1, Gia Lâm, Hà Nội (phòng tập dành riêng cho nữ)',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Giờ Hoạt Động',
        description: 'Thứ 2 – Thứ 6 (Nghỉ T7 & CN) · Ca Sáng (6h-9h) · Ca Chiều Tối (17h-19h30)',
        icon: 'tabler:clock',
      },
    ]}
  />

  <!-- QR Zalo chị Liên ************** -->

  <section class="px-4 pb-16 sm:px-6 mx-auto max-w-6xl">
    <div class="mx-auto max-w-sm rounded-2xl bg-card border border-line p-8 text-center">
      <h2 class="font-heading text-2xl text-white mb-2">Quét Là Gặp Chị Liên Ngay</h2>
      <p class="text-muted mb-6">Mở Zalo → bấm biểu tượng QR → quét mã dưới đây.</p>
      <div class="mx-auto w-56 rounded-xl bg-white p-4">
        <img
          src="/images/QR_Zalo_Lien.png"
          alt="Mã QR Zalo chị Diệu Liên — Grow Fitness (0962 468 222)"
          width="512"
          height="512"
          loading="lazy"
          class="w-full h-auto"
        />
      </div>
      <a href="https://zalo.me/0962468222" target="_blank" rel="noopener" class="btn-primary mt-6 inline-flex">
        💬 Nhắn Zalo: 0962 468 222
      </a>
    </div>
  </section>
</Layout>
