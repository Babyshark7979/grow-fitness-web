---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Liên Hệ — Grow Fitness',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Liên hệ" title="Kết Nối Cùng Grow Fitness!" />

  <ContactUs
    id="form"
    title="Gửi tin nhắn cho chúng tôi!"
    subtitle="Bạn có thắc mắc về lịch tập, gói 99K hoặc mô hình đầu tư SPV? Hãy để lại thông tin, đội ngũ CSKH sẽ hỗ trợ bạn ngay lập tức."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Họ và Tên',
      },
      {
        type: 'text',
        name: 'phone',
        label: 'Số Điện Thoại (Zalo)',
      },
    ]}
    textarea={{
      label: 'Nhu cầu cần hỗ trợ',
    }}
    disclaimer={{
      label: 'Bằng việc gửi form này, bạn đồng ý để Grow Fitness liên hệ tư vấn trực tiếp qua Zalo/Điện thoại.',
    }}
    description="Đội ngũ CSKH hỗ trợ phản hồi trong vòng 5–15 phút."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Kênh Hỗ Trợ Trực Tiếp"
    items={[
      {
        title: 'Tập luyện & Gói 99K',
        description: 'Tư vấn lịch tập nhóm GroupX nữ, Gym Private 1-1 và đăng ký gói Khám Phá 3 buổi 99K.',
        icon: 'tabler:flame',
      },
      {
        title: 'Tuyển dụng Head PT',
        description: 'Giải đáp cơ chế khoán 30M, giữ 90% lợi nhuận và cổ phần ảo Phantom Stock 12 tháng.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Đầu tư SPV 200M',
        description: 'Nhận hồ sơ minh bạch RBF 200M/suất và điều khoản mua lại Buyback.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Zalo Hotline',
        description: 'Liên hệ chị Diệu Liên (COO)',
        icon: 'tabler:headset',
      },
      {
        title: 'Địa Chỉ Cơ Sở 1',
        description: 'Tòa S109 - 01S10, Vinhomes Ocean Park 1, Gia Lâm, Hà Nội (Private Gym cho Nữ)',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Giờ Hoạt Động',
        description: 'Thứ 2 – Thứ 6 (Nghỉ T7 & CN) · Ca Sáng (6h-9h) · Ca Chiều Tối (17h-19h30)',
        icon: 'tabler:clock',
      },
    ]}
  />
</Layout>
