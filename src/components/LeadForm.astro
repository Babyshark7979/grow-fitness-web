---
// Form thu lead dùng chung cho /join, /careers, /invest, /contact.
// Backend n8n nhận POST JSON { form_type, ...fields, submitted_at } tại PUBLIC_N8N_WEBHOOK_URL.
// form_type hợp lệ: join-99k | careers-headpt | invest-spv. Trường chi tiết theo loại:
// join-99k -> muc_tieu · careers-headpt -> kinh_nghiem · invest-spv -> so_suat.
export interface LeadField {
  name: string;
  label: string;
  type?: 'text' | 'tel' | 'select';
  options?: string[];
  placeholder?: string;
}

export interface LeadTextarea {
  name: string;
  label: string;
  placeholder?: string;
  rows?: number;
}

// Map giá trị của select (typeSelect) -> form_type gửi đi + tên trường nhận nội dung textarea
export interface LeadTypeRule {
  form_type: string;
  detail?: string;
}

interface Props {
  formType: string;
  button: string;
  fields: LeadField[];
  id?: string;
  textarea?: LeadTextarea;
  disclaimer?: string;
  typeSelect?: string;
  typeMap?: Record<string, LeadTypeRule>;
}

const { formType, button, fields, id, textarea, disclaimer, typeSelect, typeMap } = Astro.props;
const webhookUrl = import.meta.env.PUBLIC_N8N_WEBHOOK_URL || '';
const zaloPhone = import.meta.env.PUBLIC_ZALO_PHONE || '';
const FANPAGE_URL = 'https://www.facebook.com/share/1DkFspwMnu/';
---

<form
  id={id}
  method="post"
  data-lead-form={formType}
  data-webhook={webhookUrl}
  data-zalo={zaloPhone}
  data-fanpage={FANPAGE_URL}
  data-type-select={typeSelect}
  data-type-map={typeMap ? JSON.stringify(typeMap) : undefined}
  data-textarea-name={textarea?.name}
  class="mx-auto max-w-xl rounded-2xl bg-card border border-line p-8 space-y-5"
  novalidate
>
  {
    fields.map((field) => (
      <div>
        <label for={`${formType}-${field.name}`} class="block mb-2 font-medium text-white">
          {field.label}
        </label>
        {field.type === 'select' ? (
          <select
            id={`${formType}-${field.name}`}
            name={field.name}
            required
            class="w-full rounded-lg bg-page border border-line px-4 py-3 text-white focus:border-primary focus:outline-none"
          >
            {(field.options || []).map((opt) => (
              <option value={opt}>{opt}</option>
            ))}
          </select>
        ) : (
          <input
            id={`${formType}-${field.name}`}
            type={field.type || 'text'}
            name={field.name}
            required
            placeholder={field.placeholder || ''}
            class="w-full rounded-lg bg-page border border-line px-4 py-3 text-white placeholder:text-muted focus:border-primary focus:outline-none"
          />
        )}
      </div>
    ))
  }

  {
    textarea && (
      <div>
        <label for={`${formType}-${textarea.name}`} class="block mb-2 font-medium text-white">
          {textarea.label}
        </label>
        <textarea
          id={`${formType}-${textarea.name}`}
          name={textarea.name}
          rows={textarea.rows || 4}
          placeholder={textarea.placeholder || ''}
          class="w-full rounded-lg bg-page border border-line px-4 py-3 text-white placeholder:text-muted focus:border-primary focus:outline-none"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <label class="flex items-start gap-3 cursor-pointer">
        <input
          type="checkbox"
          name="dong_y"
          required
          data-disclaimer-check
          class="mt-1 h-5 w-5 shrink-0 accent-[#FF2E88] cursor-pointer"
        />
        <span class="text-sm text-muted">{disclaimer}</span>
      </label>
    )
  }

  <button
    type="submit"
    disabled={!!disclaimer}
    class="btn-primary w-full disabled:opacity-40 disabled:cursor-not-allowed"
  >
    {button}
  </button>

  <p data-form-msg class="hidden text-center font-medium"></p>
</form>

<script>
  const SUBMIT_EVENTS: Record<string, string> = {
    'join-99k': 'submit_99k_form',
    'careers-headpt': 'submit_headpt_form',
    'invest-spv': 'submit_spv_form',
  };

  function track(event: string, params: Record<string, string> = {}) {
    window.dispatchEvent(new CustomEvent('grow:track', { detail: { event, ...params } }));
  }

  function bindLeadForms() {
    document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';

      // Nút Gửi chỉ sáng khi đã tích ô đồng ý (nếu form có ô này)
      const disclaimerCheck = form.querySelector<HTMLInputElement>('[data-disclaimer-check]');
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (disclaimerCheck && submitBtn) {
        disclaimerCheck.addEventListener('change', () => {
          submitBtn.disabled = !disclaimerCheck.checked;
        });
      }

      const currentFormType = () => {
        const typeSelectName = form.dataset.typeSelect;
        const typeMapRaw = form.dataset.typeMap;
        if (typeSelectName && typeMapRaw) {
          try {
            const typeMap = JSON.parse(typeMapRaw) as Record<string, { form_type: string }>;
            const sel = form.querySelector<HTMLSelectElement>(`[name="${typeSelectName}"]`);
            const rule = sel ? typeMap[sel.value] : undefined;
            if (rule) return rule.form_type;
          } catch {
            /* dùng mặc định */
          }
        }
        return form.dataset.leadForm || '';
      };

      form.addEventListener('focusin', (e) => {
        if (form.dataset.started) return;
        if (
          !(e.target instanceof HTMLInputElement) &&
          !(e.target instanceof HTMLSelectElement) &&
          !(e.target instanceof HTMLTextAreaElement)
        )
          return;
        form.dataset.started = '1';
        track('form_start', { form_type: currentFormType() });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = form.querySelector<HTMLElement>('[data-form-msg]');
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const payload: Record<string, string> = {
          form_type: form.dataset.leadForm || '',
          submitted_at: new Date().toISOString(),
        };
        new FormData(form).forEach((value, key) => {
          payload[key] = String(value);
        });
        delete payload.dong_y;

        // Chuẩn hoá + kiểm SĐT tại chỗ: báo đúng lỗi cho khách thay vì "hệ thống bận"
        if (payload.so_dien_thoai) {
          const phone = payload.so_dien_thoai.replace(/[\s.\-()]/g, '').replace(/^\+?84/, '0');
          if (!/^0\d{9}$/.test(phone)) {
            if (msg) {
              msg.classList.remove('hidden');
              msg.classList.add('text-secondary');
              msg.textContent = '📱 Số điện thoại chưa đúng (cần 10 số, bắt đầu bằng 0) — bạn kiểm tra lại giúp nhé!';
            }
            return;
          }
          payload.so_dien_thoai = phone;
        }

        // Form đa phễu (vd /contact): form_type + trường chi tiết quyết định bởi lựa chọn của khách
        const typeSelectName = form.dataset.typeSelect;
        const typeMapRaw = form.dataset.typeMap;
        if (typeSelectName && typeMapRaw) {
          try {
            const typeMap = JSON.parse(typeMapRaw) as Record<string, { form_type: string; detail?: string }>;
            const rule = typeMap[payload[typeSelectName]];
            if (rule) {
              payload.form_type = rule.form_type;
              const textareaName = form.dataset.textareaName;
              if (rule.detail && textareaName && payload[textareaName]) {
                payload[rule.detail] = payload[textareaName];
              }
            }
          } catch {
            /* giữ form_type mặc định */
          }
        }

        const fail = () => {
          if (msg) {
            msg.classList.remove('hidden');
            msg.classList.add('text-secondary');
            const zalo = form.dataset.zalo;
            if (zalo) {
              msg.innerHTML = `Bạn chưa mất chỗ đâu, hệ thống chỉ đang bận chút thôi — <a class="underline text-primary" href="https://zalo.me/${zalo}" target="_blank" rel="noopener">💬 Nhắn Zalo chị Liên ngay</a> để được giữ chỗ liền tay nhé!`;
            } else {
              msg.innerHTML = `Hệ thống đang bận — bạn nhắn trực tiếp <a class="underline text-primary" href="${form.dataset.fanpage}" target="_blank" rel="noopener">Fanpage Grow Fitness</a> để được giữ chỗ ngay nhé!`;
            }
          }
        };

        const webhook = form.dataset.webhook;
        if (!webhook) {
          fail();
          return;
        }

        if (btn) btn.disabled = true;
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 8000);
        try {
          const res = await fetch(webhook, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            signal: controller.signal,
          });
          if (!res.ok) throw new Error(String(res.status));
          form
            .querySelectorAll('input, select, textarea, button')
            .forEach((el) => ((el as HTMLInputElement).disabled = true));
          if (msg) {
            msg.classList.remove('hidden', 'text-secondary');
            msg.classList.add('text-primary');
            msg.textContent = '🎉 Chúc mừng — đã nhận thông tin! Đội ngũ Grow sẽ liên hệ Zalo của bạn trong vòng 24h.';
          }
          const eventName = SUBMIT_EVENTS[payload.form_type];
          if (eventName) track(eventName, { form_type: payload.form_type });
        } catch {
          fail();
          if (btn) btn.disabled = false;
        } finally {
          clearTimeout(timer);
        }
      });
    });
  }

  bindLeadForms();
  document.addEventListener('astro:page-load', bindLeadForms);
</script>
